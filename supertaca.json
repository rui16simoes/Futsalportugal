     "m": 1,
     "lado": "casa",
     "txt": "Arranque muito partido, com o Benfica a somar duas faltas logo nos primeiros minutos"
    },
    {
     "id": "m1_1",
     "m": 5,
     "lado": "casa",
     "txt": "Kutchy trabalha bem na ala esquerda, passa por Bruno Pinto e cruza tenso ao segundo poste sem encontrar ninguém"
    },
    {
     "id": "m1_2",
     "m": 5,
     "lado": "casa",
     "txt": "Kutchy remata de bico e a bola vai à figura de Bernardo Paçó"
    },
    {
     "id": "m1_3",
     "m": 7,
     "lado": "fora",
     "txt": "Rúben Teixeira arranca pelo corredor central e Diogo Almeida trava-o em cima da finalização"
    },
    {
     "id": "m1_4",
     "m": 7,
     "lado": "fora",
     "txt": "Rocha roda pela esquerda por fora e dá de caras com uma pressão exemplar de Léo Gugiel"
    },
    {
     "id": "m1_5",
     "m": 8,
     "lado": "fora",
     "txt": "Bernardo Paçó sobe no terreno e atira fortíssimo, mas para fora"
    },
    {
     "id": "m1_6",
     "m": 8,
     "lado": "casa",
     "txt": "Rúben Góis aparece dentro da área e Bernardo Paçó fecha-lhe o ângulo com uma parede exemplar"
    },
    {
     "id": "m1_7",
     "m": 11,
     "lado": "",
     "txt": "Grande ambiente nas bancadas do Pavilhão de Desportos, com as duas claques em peso"
    },
    {
     "id": "m1_8",
     "m": 12,
     "lado": "casa",
     "txt": "O Benfica chega às cinco faltas: a partir daqui é livre directo para o Sporting"
    },
    {
     "id": "m1_9",
     "m": 12,
     "lado": "fora",
     "txt": "Tomás Paçó tenta finalizar de primeira depois de um fora pela esquerda e a defesa encarnada corta a tempo"
    },
    {
     "id": "m1_10",
     "m": 13,
     "lado": "casa",
     "txt": "Afonso Jesus responde ao lançamento de Léo Gugiel mas, já dentro da área, atira por cima"
    },
    {
     "id": "m1_11",
     "m": 14,
     "lado": "casa",
     "txt": "Kutchy fica isolado à entrada da área num ressalto e não aproveita o espaço que tinha"
    },
    {
     "id": "m1_12",
     "m": 16,
     "lado": "fora",
     "txt": "Rocha serve Tomás Paçó e o fixo leonino inaugura o marcador"
    },
    {
     "id": "m1_13",
     "m": 17,
     "lado": "fora",
     "txt": "Tomás Paçó atira dos 15 metros e a bola bate com estrondo no poste direito"
    },
    {
     "id": "m1_14",
     "m": 17,
     "lado": "casa",
     "txt": "Cartão amarelo mostrado a Raúl Moreira, director do Benfica, no banco"
    },
    {
     "id": "m1_15",
     "m": 18,
     "lado": "fora",
     "txt": "Bernardo Paçó volta a subir pela direita e falha o alvo por cima"
    },
    {
     "id": "m1_16",
     "m": 19,
     "lado": "casa",
     "txt": "André Correia agarra o remate de Bernardo Paçó e devolve de imediato para uma baliza deserta, com a bola a sair ligeiramente por cima"
    },
    {
     "id": "m1_17",
     "m": 19,
     "lado": "casa",
     "txt": "Rúben Góis assiste e Afonso Jesus restabelece a igualdade"
